# ── Agentyllo Cloud proxy configuration ───────────────────────────────────
# Copy to .env and fill in. In Plesk you can also set these as
# "Custom environment variables" for the Node.js app instead of a file.

# Comma-separated OpenRouter API keys. Add several to multiply the daily
# free-model quota (each key = 20 req/min, and 1,000 req/day ONCE that key's
# account has ever purchased >= $10 in credits — a permanent unlock). The
# proxy rotates across them and skips a key that is rate-limited.
OPENROUTER_KEYS=sk-or-v1-xxxxxxxx,sk-or-v1-yyyyyyyy

# Port the Node app listens on (Plesk/Passenger sets this automatically; used
# only for standalone runs).
PORT=8787

# Monthly free requests allowed PER DOMAIN (the visible usage bar in the
# plugin). Keep it to a level your pooled OpenRouter quota can sustain.
MONTHLY_LIMIT_PER_DOMAIN=300

# Per-domain burst limit (requests per minute) to blunt abuse.
PER_MINUTE_PER_DOMAIN=8

# New site registrations allowed per client IP per hour.
REGISTER_PER_HOUR_PER_IP=5

# Where the JSON state file lives (domains, tokens, usage counters). Must be
# writable and OUTSIDE the web root. Default: ./data/state.json next to the app.
DATA_FILE=./data/state.json

# Optional: bias free-model ranking. Comma-separated substrings; models whose
# id contains an earlier term rank higher. The roster rotates, so these are
# hints, not hard pins. Leave as-is for sensible chat defaults.
PREFERRED_MODELS=llama-3.3-70b,qwen-2.5-72b,qwen3,gemini-2.0-flash,deepseek,gemma-3-27b,mistral

# How many free models to send as an in-request fallback chain (all :free).
MODEL_FALLBACK_COUNT=4

# Public URL sent to OpenRouter for attribution (its HTTP-Referer / X-Title).
SITE_REFERER=https://www.agentyllo.com
SITE_TITLE=Agentyllo Cloud

# Optional admin token to read /admin/stats (Bearer). Leave empty to disable.
ADMIN_TOKEN=

# Set to 1 to answer with a canned reply instead of calling OpenRouter — for
# smoke-testing the proxy end to end without spending any quota.
MOCK=0
