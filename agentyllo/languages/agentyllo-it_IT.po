#. Plugin Name of the plugin
#. Author of the plugin
#: assets/build/admin.js:1 agentyllo.php src/Admin/Menu.php:66
#: src/Admin/Menu.php:67
msgid "Agentyllo"
msgstr "Agentyllo"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: agentyllo.php
msgid "https://www.agentyllo.com"
msgstr "https://www.agentyllo.com"

#. Description of the plugin
#: agentyllo.php
msgid ""
"Intelligent AI assistant for your site: classic agents, an automatic "
"knowledge base, free local AI, and optional OpenAI/Anthropic models."
msgstr ""
"Assistente AI intelligente per il tuo sito: agenti classici, base di "
"conoscenza automatica, AI locale gratuita e modelli OpenAI/Anthropic "
"opzionali."

#. translators: %s: current PHP version.
#: agentyllo.php:41
msgid ""
"Agentyllo requires PHP 8.2 or newer. This server runs PHP %s, so the plugin "
"stays inactive."
msgstr ""
"Agentyllo richiede PHP 8.2 o successivo. Questo server usa PHP %s, quindi il"
" plugin resta inattivo."

#. translators: %s: current WordPress version.
#: agentyllo.php:61
msgid ""
"Agentyllo requires WordPress 6.8 or newer. This site runs WordPress %s, so "
"the plugin stays inactive."
msgstr ""
"Agentyllo richiede WordPress 6.8 o successivo. Questo sito usa WordPress %s,"
" quindi il plugin resta inattivo."

#: src/Admin/Assets.php:37
msgid ""
"Agentyllo admin assets are not built. Run \"npm install && npm run build\" "
"in the plugin repository."
msgstr ""
"Gli asset admin di Agentyllo non sono compilati. Esegui \"npm install && npm"
" run build\" nel repository del plugin."

