#. translators: %1$s: site name.
#: src/Chat/Templates.php:66
msgid ""
"Good day — you have reached the %1$s assistant. What can I help you with?"
msgstr ""
"Buongiorno — hai raggiunto l'assistente di %1$s. In cosa posso aiutarti?"

#. translators: %1$s: site name.
#: src/Chat/Templates.php:68
msgid "Welcome to %1$s. Please let me know what you are looking for."
