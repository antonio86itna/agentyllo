{
	"name": "agentyllo/agentyllo",
	"description": "Intelligent AI assistant for WordPress: classic agents, automatic knowledge base, free local AI, optional OpenAI/Anthropic.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0",
		"brain/monkey": "^2.7"
	},
	"autoload": {
		"psr-4": {
			"Agentyllo\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Agentyllo\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"platform": {
			"php": "8.2.99"
		},
		"sort-packages": true
	}
}
